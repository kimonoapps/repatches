index 51e37a5..62d7d0b 100644
--- a/i18n/en.json
+++ b/i18n/en.json
@@ -569,7 +569,7 @@
   "app_architecture_variant": "Variant (Architecture)",
   "app_bar_signout_dialog_content": "Are you sure you want to sign out?",
   "app_bar_signout_dialog_title": "Sign out",
-  "app_download_links": "App Download Links",
+  "app_download_links": "Get the app",
   "app_settings": "App Settings",
   "app_stores": "App Stores",
   "app_update_available": "App update is available",
@@ -1495,7 +1495,7 @@
   "minutes": "Minutes",
   "missing": "Missing",
   "mobile_app": "Mobile App",
-  "mobile_app_download_onboarding_note": "Download the companion mobile app using the following options",
+  "mobile_app_download_onboarding_note": "Back up this phone with the Kimono app.",
   "model": "Model",
   "modify_date": "Modify Date",
   "month": "Month",
diff --git a/server/src/services/api.service.ts b/server/src/services/api.service.ts
index 992c2f1..6b63b69 100644
--- a/server/src/services/api.service.ts
+++ b/server/src/services/api.service.ts
@@ -20,6 +20,13 @@ const isAutoLaunchOptOut = (query: Request['query']) =>
   'code' in query ||
   'error' in query;
 
+// Kimono: the phone app comes from Kimono, so "Get the app" anywhere in the web app goes to Kimono's own page.
+const GET_APP_PATH = '/get-app';
+const getAppUrl = () => {
+  const url = process.env.KIMONO_GET_APP_URL ?? '';
+  return /^https?:\/\//.test(url) ? url : null;
+};
+
 export const render = (index: string, meta: OpenGraphTags) => {
   const [title, description, imageUrl] = [meta.title, meta.description, meta.imageUrl].map((item) =>
     item ? escape(item) : '',
@@ -107,6 +114,12 @@ export class ApiService {
         );
       }
 
+      const kimonoGetApp = request.path === GET_APP_PATH ? getAppUrl() : null;
+      if (kimonoGetApp) {
+        const query = request.url.indexOf('?');
+        return res.header('Cache-Control', 'no-store').redirect(302, kimonoGetApp + (query === -1 ? '' : request.url.slice(query)));
+      }
+
       if (await this.redirectToOAuth(request, res)) {
         return;
       }
