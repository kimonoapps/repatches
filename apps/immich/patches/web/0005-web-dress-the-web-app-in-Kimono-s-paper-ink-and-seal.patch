+  --immich-ui-warning-950: color-mix(in oklch, #dcc090 22%, #fffdf8);
+  --immich-ui-info-50: color-mix(in oklch, #d59aa4 8%, #1d1417);
+  --immich-ui-info-100: color-mix(in oklch, #d59aa4 18%, #1d1417);
+  --immich-ui-info-200: color-mix(in oklch, #d59aa4 34%, #1d1417);
+  --immich-ui-info-300: color-mix(in oklch, #d59aa4 52%, #1d1417);
+  --immich-ui-info-400: color-mix(in oklch, #d59aa4 74%, #1d1417);
+  --immich-ui-info-500: #d59aa4;
+  --immich-ui-info-600: color-mix(in oklch, #d59aa4 80%, #fffdf8);
+  --immich-ui-info-700: color-mix(in oklch, #d59aa4 62%, #fffdf8);
+  --immich-ui-info-800: color-mix(in oklch, #d59aa4 46%, #fffdf8);
+  --immich-ui-info-900: color-mix(in oklch, #d59aa4 32%, #fffdf8);
+  --immich-ui-info-950: color-mix(in oklch, #d59aa4 22%, #fffdf8);
+  --immich-ui-primary-400: #8d7fb5;
+  --immich-ui-primary-200: #3b3357;
+
+  --immich-ui-light: #1d1417;
+  --immich-ui-dark: #f3e9e0;
+  --immich-ui-muted: #a8969c;
+  --immich-ui-gray: #2a1d22;
+  --immich-ui-default-border: #45333a;
+}
+
+html.light,
+html.light body {
+  background-color: var(--k-sheet);
+}
+html.dark,
+html.dark body {
+  background-color: var(--k-ground);
+}
+body {
+  color: var(--k-ink);
+  font-family: var(--k-sans);
+  -webkit-font-smoothing: antialiased;
+}
+::selection {
+  background: var(--k-accent-pale);
+}
+:focus-visible {
+  outline-color: var(--k-accent);
+}
+
+/* ── type: Mincho names things ──────────────────────────────────────────── */
+[data-k-heading],
+#dashboard-navbar ~ * h1,
+main h1,
+main h2 {
+  font-family: var(--k-display);
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+/* page titles and album names are named things too */
+#user-page-header {
+  font-family: var(--k-display);
+  font-size: 21px;
+  font-weight: 600;
+  color: var(--k-plum);
+}
+.text-2xl.lg\:text-6xl {
+  font-family: var(--k-display);
+  font-weight: 600;
+  letter-spacing: -0.015em;
+}
+
+/* 肖 a person without a picture: their initial in plum Mincho on fold paper */
+[data-k-avatar] {
+  background: var(--k-fold);
+  color: var(--k-plum);
+  box-shadow: inset 0 0 0 1px var(--k-hair);
+  font-family: var(--k-display);
+}
+
+/* control bars (album, asset and selection toolbars): a flat plank, not a capsule */
+.h-control-bar {
+  border-radius: 2px;
+}
+
+/* ── paper stacks; it does not glow: no blurred shadows, no backdrop blur ── */
+.shadow-sm,
+.shadow,
+.shadow-md,
+.shadow-lg,
+.shadow-xl,
+.shadow-2xl {
+  box-shadow: 0 1px 0 color-mix(in srgb, var(--k-plum) 8%, transparent) !important;
+}
+.backdrop-blur,
+.backdrop-blur-sm,
+.backdrop-blur-md,
+.backdrop-blur-lg,
+.backdrop-blur-xl,
+[class*='backdrop-blur-['] {
+  backdrop-filter: none !important;
+}
+
+/* 紐 the cord under the header: 2px plum over 1px sakura, as in every Kimono header */
+#dashboard-navbar {
+  position: relative;
+  background: var(--k-ground);
+}
+#dashboard-navbar::after {
+  content: '';
+  position: absolute;
+  inset: auto 0 0 0;
+  height: 2px;
+  background: #4e2b37;
+  box-shadow: 0 1px 0 #d59aa4;
+  pointer-events: none;
+}
+#dashboard-navbar > div {
+  border-bottom: 0;
+}
+.dark #dashboard-navbar::after {
+  background: #f2cbd2;
+  box-shadow: 0 1px 0 #6b3445;
+}
+
+/* ── sidebar: no pills; the chosen room gets a 3px marker in Photos' colour ── */
+[data-k-nav],
+.rounded-e-full {
+  border-start-end-radius: 2px;
+  border-end-end-radius: 2px;
+}
+[data-k-nav='active'] {
+  background: var(--k-hover);
+  color: var(--k-accent);
+  box-shadow: inset 3px 0 0 var(--k-app-accent);
+}
+.dark [data-k-nav='active'] {
+  background: var(--k-fold);
+}
+
+/* ── 判 seals: a carved block, not a pill ───────────────────────────────── */
+[data-k='seal'] {
+  --k-seal-face: var(--k-accent);
+  --k-seal-ink: var(--k-lift);
+  --k-seal-base: color-mix(in srgb, var(--k-seal-face) 72%, #24221f);
+  position: relative;
+  border-radius: 2px;
+  font-weight: 700;
+  letter-spacing: 0.04em;
+  transition:
+    background-color 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
+    color 180ms cubic-bezier(0.2, 0.9, 0.25, 1),
+    transform 120ms cubic-bezier(0.2, 0.9, 0.25, 1),
+    box-shadow 400ms cubic-bezier(0.2, 0.9, 0.25, 1);
+}
+/* inked: primary and every other filled colour except the quiet secondary */
+[data-k='seal'][data-k-variant='filled'] {
+  background: var(--k-seal-face);
+  color: var(--k-seal-ink);
+  box-shadow: inset 0 -2px 0 var(--k-seal-base);
+}
+[data-k='seal'][data-k-variant='filled']::before {
+  content: '';
+  position: absolute;
+  inset: 3px;
+  border: 1px solid color-mix(in srgb, var(--k-seal-ink) 32%, transparent);
+  border-radius: 1px;
+  pointer-events: none;
+  transition: inset 120ms cubic-bezier(0.2, 0.9, 0.25, 1);
+}
+[data-k='seal'][data-k-variant='filled']:not(:disabled):hover {
+  background: color-mix(in srgb, var(--k-seal-face) 82%, #24221f);
+}
+.dark [data-k='seal'][data-k-variant='filled']:not(:disabled):hover {
+  background: color-mix(in srgb, var(--k-seal-face) 82%, #fffdf8);
+}
+[data-k='seal'][data-k-variant='filled']:not(:disabled):active {
+  transform: translateY(1px);
+  box-shadow: inset 0 0 0 var(--k-seal-base);
+}
+[data-k='seal'][data-k-variant='filled']:not(:disabled):active::before {
+  inset: 4px;
+}
+[data-k='seal'][data-k-color='success'] {
+  --k-seal-face: var(--immich-ui-success-500);
+}
+[data-k='seal'][data-k-color='warning'] {
+  --k-seal-face: var(--immich-ui-warning-500);
+}
+[data-k='seal'][data-k-color='info'] {
+  --k-seal-face: var(--immich-ui-info-500);
+}
+/* quiet: the same block uninked — fold paper on a hair base, no ring */
+[data-k='seal'][data-k-variant='filled'][data-k-color='secondary'],
+[data-k='seal'][data-k-variant='outline'] {
+  --k-seal-base: var(--k-hair-deep);
+  background: var(--k-fold);
+  color: var(--k-ink);
+  border-color: transparent;
+  box-shadow: inset 0 -2px 0 var(--k-seal-base);
+}
+[data-k='seal'][data-k-variant='filled'][data-k-color='secondary']::before,
+[data-k='seal'][data-k-variant='outline']::before {
+  display: none;
+}
+[data-k='seal'][data-k-variant='filled'][data-k-color='secondary']:not(:disabled):hover,
+[data-k='seal'][data-k-variant='outline']:not(:disabled):hover {
+  background: color-mix(in srgb, var(--k-fold) 60%, var(--k-hair));
+  color: var(--k-plum);
+}
+/* danger: the consequence on a rose wash, inked only when you reach for it */
+[data-k='seal'][data-k-color='danger'] {
+  --k-seal-base: color-mix(in srgb, var(--k-danger) 28%, var(--k-danger-wash));
+  background: var(--k-danger-wash);
+  color: var(--k-danger-deep);
+  box-shadow: inset 0 -2px 0 var(--k-seal-base);
+}
+[data-k='seal'][data-k-color='danger']::before {
+  opacity: 0;
+}
+[data-k='seal'][data-k-color='danger']:not(:disabled):hover {
+  --k-seal-base: #5f2535;
+  background: var(--k-danger-deep);
+  color: var(--k-lift);
+}
+[data-k='seal'][data-k-color='danger']:not(:disabled):hover::before {
+  opacity: 1;
+}
+/* ghost: a word that acts; it marks itself only on reach */
+[data-k='seal'][data-k-variant='ghost'] {
+  letter-spacing: 0.02em;
+}
+/* ...unless Immich gave it a surface of its own: then it is a quiet seal */
+[data-k='seal'][data-k-variant='ghost'][class*='bg-white'],
+.dark [data-k='seal'][data-k-variant='ghost'][class*='dark:bg-'] {
+  background: var(--k-fold);
+  color: var(--k-ink);
+  border-color: transparent;
+  box-shadow: inset 0 -2px 0 var(--k-hair-deep);
+}
+/* lifted off its base */
+[data-k='seal']:disabled,
+[data-k='seal'][aria-disabled='true'] {
+  box-shadow: none;
+  transform: none;
+}
+[data-k='seal']:disabled::before,
+[data-k='seal'][aria-disabled='true']::before {
+  display: none;
+}
+/* icon-only controls: square-cut, not circles */
+[data-k='icon'] {
+  border-radius: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  [data-k='seal'],
+  [data-k='seal']::before {
+    transition: none;
+  }
+}
