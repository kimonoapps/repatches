+  font-family: 'Zen Maru Gothic Kimono';
+  src: url('/fonts/kimono/zen-maru-gothic-latin-400-normal.woff2') format('woff2');
+  font-weight: 400;
+  font-display: swap;
+}
+@font-face {
+  font-family: 'Zen Maru Gothic Kimono';
+  src: url('/fonts/kimono/zen-maru-gothic-latin-500-normal.woff2') format('woff2');
+  font-weight: 500;
+  font-display: swap;
+}
+@font-face {
+  font-family: 'Zen Maru Gothic Kimono';
+  src: url('/fonts/kimono/zen-maru-gothic-latin-700-normal.woff2') format('woff2');
+  font-weight: 600 700;
+  font-display: swap;
