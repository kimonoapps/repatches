From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: akram-composio <akram@composio.dev>
Date: Tue, 10 Nov 2026 22:12:05 -0800
Subject: [PATCH] mobile: Tell Kimono which version is installed

Kimono offers TestFlight's newer Kimono Photos as an update, as it does the
APK on Android, but iOS won't tell one app another's version. So the app
leaves its version and build in the keychain group it shares with Kimono
(app.kimono.shared) on each launch. A keychain group, not an App Group: it
needs nothing set up on the App ID, so automatic signing in CI covers it.

Must survive upstream changes:
- Runner.entitlements and RunnerProfile.entitlements list keychain-access-groups
  $(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER) first (still the default
  group, where upstream's own keychain items go), then
  $(AppIdentifierPrefix)app.kimono.shared.
- Info.plist takes CFBundleShortVersionString and CFBundleVersion from
  $(FLUTTER_BUILD_NAME) and $(FLUTTER_BUILD_NUMBER). Upstream hardcodes them
  (3.3.6 and 4), which ignores the release's --build-number: TestFlight then
  refuses every upload after the first, and Kimono can't compare builds.
- Info.plist KimonoKeychainGroup is $(AppIdentifierPrefix)app.kimono.shared.
- At launch, AppDelegate writes "<version>\n<build>" as a generic password,
  service app.kimono.installed, account the bundle ID, in that group.

diff --git a/mobile/ios/Runner/AppDelegate.swift b/mobile/ios/Runner/AppDelegate.swift
index e1ff3b1..ac26092 100644
--- a/mobile/ios/Runner/AppDelegate.swift
+++ b/mobile/ios/Runner/AppDelegate.swift
@@ -1,3 +1,4 @@
+import Security
 import native_video_player
 
 @main
@@ -15,6 +16,20 @@ import native_video_player
     URLSessionManager.patchBackgroundDownloader()
     BackgroundWorkerApiImpl.registerBackgroundWorkers()
 
+    // Kimono reads this build's version from the keychain group it shares, to offer TestFlight's newer one.
+    if let group = Bundle.main.object(forInfoDictionaryKey: "KimonoKeychainGroup") as? String, !group.hasPrefix("$("),
+       let id = Bundle.main.bundleIdentifier {
+      let info = Bundle.main.infoDictionary
+      let value = Data("\(info?["CFBundleShortVersionString"] as? String ?? "")\n\(info?["CFBundleVersion"] as? String ?? "")".utf8)
+      let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword, kSecAttrService as String: "app.kimono.installed", kSecAttrAccount as String: id, kSecAttrAccessGroup as String: group]
+      if SecItemUpdate(query as CFDictionary, [kSecValueData as String: value] as CFDictionary) == errSecItemNotFound {
+        var add = query
+        add[kSecValueData as String] = value
+        add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlock
+        SecItemAdd(add as CFDictionary, nil)
+      }
+    }
+
     return super.application(application, didFinishLaunchingWithOptions: launchOptions)
   }
 
diff --git a/mobile/ios/Runner/Info.plist b/mobile/ios/Runner/Info.plist
index 2879b9c..3eb8369 100644
--- a/mobile/ios/Runner/Info.plist
+++ b/mobile/ios/Runner/Info.plist
@@ -13,6 +13,8 @@
     <true />
     <key>CFBundleDevelopmentRegion</key>
     <string>$(DEVELOPMENT_LANGUAGE)</string>
+    <key>KimonoKeychainGroup</key>
+    <string>$(AppIdentifierPrefix)app.kimono.shared</string>
     <key>CFBundleDisplayName</key>
     <string>Kimono Photos</string>
     <key>CFBundleDocumentTypes</key>
@@ -78,7 +80,7 @@
     <key>CFBundlePackageType</key>
     <string>APPL</string>
     <key>CFBundleShortVersionString</key>
-    <string>3.3.6</string>
+    <string>$(FLUTTER_BUILD_NAME)</string>
     <key>CFBundleSignature</key>
     <string>????</string>
     <key>CFBundleURLTypes</key>
@@ -105,7 +107,7 @@
       </dict>
     </array>
     <key>CFBundleVersion</key>
-    <string>4</string>
+    <string>$(FLUTTER_BUILD_NUMBER)</string>
     <key>ITSAppUsesNonExemptEncryption</key>
     <false />
     <key>LSApplicationQueriesSchemes</key>
diff --git a/mobile/ios/Runner/Runner.entitlements b/mobile/ios/Runner/Runner.entitlements
index 9f15cc4..8db45ea 100644
--- a/mobile/ios/Runner/Runner.entitlements
+++ b/mobile/ios/Runner/Runner.entitlements
@@ -4,6 +4,11 @@
 <dict>
 	<key>com.apple.developer.networking.wifi-info</key>
 	<true/>
+	<key>keychain-access-groups</key>
+	<array>
+		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
+		<string>$(AppIdentifierPrefix)app.kimono.shared</string>
+	</array>
 	<key>com.apple.security.application-groups</key>
 	<array>
 		<string>$(CUSTOM_GROUP_ID)</string>
diff --git a/mobile/ios/Runner/RunnerProfile.entitlements b/mobile/ios/Runner/RunnerProfile.entitlements
index b7930d5..4412d0b 100644
--- a/mobile/ios/Runner/RunnerProfile.entitlements
+++ b/mobile/ios/Runner/RunnerProfile.entitlements
@@ -6,6 +6,11 @@
 	<string>development</string>
 	<key>com.apple.developer.networking.wifi-info</key>
 	<true/>
+	<key>keychain-access-groups</key>
+	<array>
+		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
+		<string>$(AppIdentifierPrefix)app.kimono.shared</string>
+	</array>
 	<key>com.apple.security.application-groups</key>
 	<array>
 		<string>$(CUSTOM_GROUP_ID)</string>
