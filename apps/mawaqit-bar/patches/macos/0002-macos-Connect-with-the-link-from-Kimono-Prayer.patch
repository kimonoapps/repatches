         if state.notificationsEnabled {
@@ -77,7 +79,47 @@ final class MawaqitStore: ObservableObject {
         }
     }
 
+    static let connectPrompt = "Paste your link from Kimono Prayer and press Return."
+
+    /// A Kimono Prayer link, from the search field or a mawaqit-kimono://connect address.
+    func connect(_ link: URL) {
+        searchTask?.cancel()
+        refreshTask?.cancel()
+        let notifications = state.notificationsEnabled
+        state = SavedState(notificationsEnabled: notifications, link: link.absoluteString)
+        query = ""
+        results = []
+        calculatedSuggestion = nil
+        status = ""
+        save()
+        render()
+        scheduleNotifications()
+        refresh()
+    }
+
+    func disconnect() {
+        searchTask?.cancel()
+        refreshTask?.cancel()
+        state = SavedState(notificationsEnabled: state.notificationsEnabled)
+        query = ""
+        results = []
+        calculatedSuggestion = nil
+        status = Self.connectPrompt
+        isLoading = false
+        save()
+        render()
+        scheduleNotifications()
+    }
+
     func submitSearch() {
+        if let link = KimonoLink.parse(query) {
+            connect(link)
+            return
+        }
+        guard isConnected else {
+            status = Self.connectPrompt
+            return
+        }
         searchTask?.cancel()
         results = []
         calculatedSuggestion = nil
diff --git a/macos/Tests/MawaqitMacTests/KimonoLinkTests.swift b/macos/Tests/MawaqitMacTests/KimonoLinkTests.swift
new file mode 100644
index 0000000..dc7c417
--- /dev/null
+++ b/macos/Tests/MawaqitMacTests/KimonoLinkTests.swift
@@ -0,0 +1,25 @@
+import Foundation
+import Testing
+@testable import MawaqitMac
+
+@Suite("Kimono link")
+struct KimonoLinkTests {
+    let link = "https://kimono.example/api/v1/prayer/feed/abc_DEF-123"
+
+    @Test func acceptsThePastedLink() {
+        #expect(KimonoLink.parse("  \(link)\n")?.absoluteString == link)
+    }
+
+    @Test func acceptsTheConnectAddress() {
+        let encoded = link.addingPercentEncoding(withAllowedCharacters: .alphanumerics)!
+        #expect(KimonoLink.parse("mawaqit-kimono://connect?link=\(encoded)")?.absoluteString == link)
+    }
+
+    @Test func dropsAQueryAndRefusesOtherAddresses() {
+        #expect(KimonoLink.parse("\(link)?q=paris")?.absoluteString == link)
+        #expect(KimonoLink.parse("https://kimono.example/prayer") == nil)
+        #expect(KimonoLink.parse("ftp://kimono.example/api/v1/prayer/feed/abc") == nil)
+        #expect(KimonoLink.parse("mawaqit-kimono://other?link=\(link)") == nil)
+        #expect(KimonoLink.parse("Paris") == nil)
+    }
+}
